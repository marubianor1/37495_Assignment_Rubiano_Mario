dat<- c(1, 2, 3, 1, 0, 9, 1, 8, 0)
X <- matrix(dat, nrow = 3, ncol = 3, byrow = T)
X
t(X)
t(X)%*%x
t(X)%*%X
t(X)*X
G<-t(X)%*%X
eigrn(G,symmetric=T)
G<-t(X)%*%X
eigen(G,symmetric=T)
install.packages("expm")
library(expm)
sqrtm(G)
expm(-G)
